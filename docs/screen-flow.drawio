  <diagram id="roadmap" name="01 - Implementation Roadmap">
    <mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="r-title" value="F-Cinema — Recommended Screen Implementation Roadmap" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="300" y="20" width="1300" height="40" as="geometry"/></mxCell>
        <mxCell id="r-0" value="PHASE 0 — FOUNDATION&#xa;Brand Logo + design system&#xa;G01, G02, G03, Verify Email&#xa;G04 → G04b → G04c → G04d" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="r-1" value="PHASE 1 — DISCOVERY&#xa;C01 Movies&#xa;C02 Movie Detail&#xa;C08/C09 Cinema + Showtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="r-2" value="PHASE 2 — BOOKING MVP&#xa;NEW Seat Selection&#xa;C13 → C14 → C15 → C17&#xa;Hold → Pay → Issue Ticket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="600" y="140" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="r-3" value="PHASE 3 — CUSTOMER SELF-SERVICE&#xa;Dashboard, bookings, refunds&#xa;Profile/security, loyalty&#xa;Reviews + transaction history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="870" y="140" width="230" height="150" as="geometry"/></mxCell>
        <mxCell id="r-4" value="PHASE 4 — STAFF OPERATIONS&#xa;Ticket POS + gate scan&#xa;Concession POS&#xa;Inventory + stock receipt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1150" y="140" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="r-5" value="PHASE 5 — MANAGER OPERATIONS&#xa;Movies, showtimes, rooms&#xa;Promotions, shifts&#xa;Analytics + revenue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1420" y="140" width="220" height="150" as="geometry"/></mxCell>
        <mxCell id="r-6" value="PHASE 6 — SYSTEM ADMIN&#xa;Staff accounts&#xa;Roles + permissions&#xa;Cinema branches + audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1690" y="140" width="180" height="150" as="geometry"/></mxCell>
        <mxCell id="re01" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="r-0" target="r-1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="r-1" target="r-2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="r-2" target="r-3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="r-3" target="r-4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="r-4" target="r-5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="r-5" target="r-6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-note" value="Why this order?  Each phase consumes stable capabilities from the phase before it. The revenue path is delivered before operational dashboards; governance is added after the underlying workflows exist." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;align=left;spacing=15;" vertex="1" parent="1"><mxGeometry x="300" y="380" width="1300" height="90" as="geometry"/></mxCell>
        <mxCell id="r-gaps" value="Required gaps before release&#xa;1. Seat Selection&#xa;2. Payment failed / pending / retry&#xa;3. Seat-hold expiry&#xa;4. 403 / 404 / 500 / offline&#xa;5. Ticket scan result variants&#xa;6. Refund detail + approval outcome&#xa;7. Mutation confirmations / success states&#xa;8. Shared sign-in role redirect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1"><mxGeometry x="540" y="540" width="820" height="270" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
