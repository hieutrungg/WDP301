PORT=5000

MONGODB_URI=mongodb://localhost:27017/cinema_management
# Optional: use when a local DNS proxy refuses Atlas SRV lookups.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
ALLOW_REMOTE_DEVELOPMENT_SEED=false

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

CLIENT_URL=http://localhost:5173

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-sender@gmail.com
EMAIL_PASS=
EMAIL_FROM=F-Cinema <your-sender@gmail.com>

GOOGLE_CLIENT_ID=

# payOS bank transfer (VietQR). Leave empty to use the internal mock gateway in development.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Optional override, default https://api-merchant.payos.vn
# PAYOS_API_BASE_URL=

# AI-001 assistant (OpenAI). Leave OPENAI_API_KEY empty to disable /api/ai (503 AI_DISABLED).
# Never commit a real key. See docs/AI-001-ATLAS-SETUP.md.
OPENAI_API_KEY=
# Optional overrides (defaults shown):
# OPENAI_CHAT_MODEL=gpt-5-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_MODERATION_MODEL=omni-moderation-latest
# AI_TRACE_RETENTION_DAYS=30
# AI_STORE_RESPONSES=false
